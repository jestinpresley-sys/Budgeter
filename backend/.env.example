# Get these from https://dashboard.plaid.com (free sandbox account, instant signup)
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# sandbox -> fake banks, fake data, unlimited testing
# development -> real banks, your own real accounts, limited item count
# production -> real banks, real users, requires Plaid's production access review
PLAID_ENV=sandbox

# Where your frontend runs, for CORS
CLIENT_ORIGIN=http://localhost:5173

PORT=8080
